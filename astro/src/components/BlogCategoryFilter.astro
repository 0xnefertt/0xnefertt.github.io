---
import { localeFromPath, localizedPath, localeText } from "../lib/locale";
import { t } from "../lib/messages";
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { type BlogCategoryTreeParent } from "../lib/blog";

interface Props {
  activeChildSlug?: string;
  activeParentSlug?: string;
  categoryTree: BlogCategoryTreeParent[];
  isAllActive?: boolean;
  totalCount: number;
}

const { activeChildSlug, activeParentSlug, categoryTree, isAllActive = false, totalCount } = Astro.props;
const activeParent = categoryTree.find((parent) => parent.slug === activeParentSlug);
const children = activeParent?.children.filter((child) => child.count > 0) ?? [];
---

{categoryTree.length > 0 && (
  <div class="blog-category-bar">
    <nav class="blog-category-tabs" aria-label={localeText(locale, "Main categories", "주요 카테고리")}>
      <a href={l("/blog/")} class={isAllActive ? "active" : undefined} aria-current={isAllActive ? "page" : undefined}>
        <span data-i18n-key="blog_all">{t(locale, "blog_all")}</span> <span class="category-count">{totalCount}</span>
      </a>
      {categoryTree.map((parent) =>
        parent.count > 0 ? (
          <a
            href={parent.href}
            class={parent.slug === activeParentSlug ? "active" : undefined}
            aria-current={parent.slug === activeParentSlug && !activeChildSlug ? "page" : undefined}
          >
            <span>{parent.name}</span>
          </a>
        ) : (
          <span class="category-disabled" aria-disabled="true">
            <span>{parent.name}</span>
          </span>
        )
      )}
    </nav>
    {activeParent && children.length > 0 && (
      <nav class="blog-subcategories" aria-label={localeText(locale, `${activeParent.name} subcategories`, `${activeParent.name} 하위 카테고리`)}>
        {children.map((child) => (
          <a href={child.href} aria-current={child.slug === activeChildSlug ? "page" : undefined}>
            {child.name} <span class="category-count">{child.count}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>(".blog-category-tabs > a.active").forEach((link) => {
    const tabs = link.parentElement;
    if (!tabs) return;
    const tab = link.getBoundingClientRect();
    const viewport = tabs.getBoundingClientRect();
    if (tab.right > viewport.right) tabs.scrollLeft += tab.right - viewport.right;
    else if (tab.left < viewport.left) tabs.scrollLeft += tab.left - viewport.left;
  });
</script>
