---
import { getCategoryI18nKey, type BlogCategoryTreeParent } from '../lib/blog';

interface Props {
  activeChildSlug?: string;
  activeParentSlug?: string;
  categoryTree: BlogCategoryTreeParent[];
  isAllActive?: boolean;
  totalCount: number;
}

const { activeChildSlug, activeParentSlug, categoryTree, isAllActive = false, totalCount } = Astro.props;
---

{
  categoryTree.length > 0 && (
    <div class="blog-category-bar">
      <nav class="blog-category-tabs" aria-label="주요 카테고리">
        <a href="/blog/" class={isAllActive ? 'active' : undefined} aria-current={isAllActive ? 'page' : undefined}>
          <span data-i18n-key="blog_all">전체 글</span> <span class="category-count">{totalCount}</span>
        </a>
        {categoryTree.map((parent) => (
          <a href={parent.href} class={parent.slug === activeParentSlug ? 'active' : undefined} aria-current={parent.slug === activeParentSlug && !activeChildSlug ? 'page' : undefined}>
            <span data-i18n-key={getCategoryI18nKey(parent.href)}>{parent.name}</span>
          </a>
        ))}
      </nav>
      <details class="category-disclosure">
        <summary><span data-i18n-key="blog_categories">카테고리</span><span aria-hidden="true">⌄</span></summary>
        <nav class="blog-category-filter" aria-label="Blog categories">
          <ul class="blog-category-parent-list">
            <li>
              <a href="/blog/" class={isAllActive ? 'active' : undefined}>
                <span data-i18n-key="blog_all">전체 글</span> <span class="category-count">({totalCount})</span>
              </a>
            </li>
            {categoryTree.map((parent) => (
              <li class="blog-category-parent-item">
                <a href={parent.href} class={parent.slug === activeParentSlug && !activeChildSlug ? 'active' : undefined}>
                  <span data-i18n-key={getCategoryI18nKey(parent.href)}>{parent.name}</span>{' '}
                  <span class="category-count">({parent.count})</span>
                </a>
                {parent.children.length > 0 && (
                  <ul class="blog-category-child-list">
                    {parent.children.map((child) => (
                      <li>
                        <a href={child.href} class={parent.slug === activeParentSlug && child.slug === activeChildSlug ? 'active' : undefined}>
                          <span data-i18n-key={getCategoryI18nKey(child.href)}>{child.name}</span>{' '}
                          <span class="category-count">({child.count})</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.blog-category-tabs > a.active').forEach((link) => {
    const tabs = link.parentElement;
    if (tabs) tabs.scrollLeft += link.getBoundingClientRect().left - tabs.getBoundingClientRect().left - 12;
  });
  document.querySelectorAll<HTMLDetailsElement>('.category-disclosure').forEach((disclosure) => {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !disclosure.contains(event.target)) disclosure.open = false;
    });
    disclosure.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        disclosure.open = false;
        disclosure.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  });
</script>
