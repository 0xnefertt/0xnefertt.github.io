---
import { localeFromPath, localizedPath, localeText, contentLocale } from "../lib/locale";
import { t } from "../lib/messages";
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostShare from "./PostShare.astro";
import {
  formatPostDate,
  getBlogHref,
  getPublishedBlogPosts,
  getPostCategories,
  getPostCategoryPaths,
  getPostImages,
  normalizeTaxonomy,
  sortPostsDesc,
  toBlogSummary,
} from "../lib/blog";
import { siteConfig } from "../lib/site";
import { normalizeAssetPath } from "../lib/content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const headerImage = getPostImages(post).previewImages[0];
const outline = headings.filter((heading) => heading.depth === 2);
const tags = normalizeTaxonomy(post.data.tags);
const categories = getPostCategories(post);
const categoryPaths = getPostCategoryPaths(post);
const redirectTarget = post.data.redirect;
const allPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection("blog")), locale);

function tagKey(tag: string) {
  return tag.trim().normalize("NFC").toLowerCase();
}

const currentTags = new Set(tags.map(tagKey));
const currentCategories = new Set(categories);
const recommendedPosts = allPosts
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => {
    const sharedCategoryCount = getPostCategories(candidate).filter((category) => currentCategories.has(category)).length;
    const sharedTagCount = normalizeTaxonomy(candidate.data.tags).filter((tag) => currentTags.has(tagKey(tag))).length;
    return { candidate, score: sharedCategoryCount * 4 + sharedTagCount * 2 };
  })
  // allPosts is already newest first, including ties and posts without shared terms.
  .sort((a, b) => b.score - a.score)
  .slice(0, 6)
  .map(({ candidate }) => toBlogSummary(candidate));

const currentIndex = allPosts.findIndex((candidate) => candidate.id === post.id);
const previousPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? toBlogSummary(allPosts[currentIndex + 1]) : undefined;
const nextPost = currentIndex > 0 ? toBlogSummary(allPosts[currentIndex - 1]) : undefined;
const { href: postHref } = getBlogHref(post);
const canonicalPostUrl = new URL(postHref, siteConfig.siteUrl).toString();

function toAbsoluteUrl(input: string): string {
  if (/^https?:\/\//.test(input)) {
    return input;
  }

  const normalized = input.startsWith("/") ? input : `/${input}`;
  return new URL(normalized, siteConfig.siteUrl).toString();
}

const articleImageUrl = toAbsoluteUrl(post.data.thumbnail ?? siteConfig.defaultOgImage);
const aboutPage = (await getCollection("pages")).find((entry) => entry.filePath?.endsWith("/about.md") && contentLocale(entry) === locale);
const profile = aboutPage?.data.profile;
const ownerPost = !post.data.author || post.data.author === "0xnefertt" || post.data.author === profile?.name;
const authorName = ownerPost ? (profile?.name ?? siteConfig.title) : post.data.author;
const authorImage = normalizeAssetPath(profile?.image);
const authorUrl = new URL(l("/"), siteConfig.siteUrl).toString();
const publishedIso = post.data.date?.toISOString();
const modifiedIso = (post.data.last_updated ?? post.data.date)?.toISOString();
const keywordValues = [...tags, ...categories];
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  inLanguage: locale,
  description: post.data.description ?? post.data.title,
  author: {
    "@type": "Person",
    name: authorName,
    url: authorUrl,
    ...(ownerPost ? { sameAs: siteConfig.socialLinks.filter((link) => link.label !== "email").map((link) => link.href) } : {}),
  },
  publisher: {
    "@type": "Person",
    name: profile?.name ?? siteConfig.title,
    url: authorUrl,
  },
  mainEntityOfPage: canonicalPostUrl,
  image: [articleImageUrl],
  datePublished: publishedIso,
  dateModified: modifiedIso,
  keywords: keywordValues.join(", "),
}).replace(/</g, "\\u003c");

const giscusConfig = siteConfig.giscus;
const hasGiscus =
  giscusConfig.repo.length > 0 && giscusConfig.repoId.length > 0 && giscusConfig.category.length > 0 && giscusConfig.categoryId.length > 0;
const showComments = hasGiscus && (post.data.giscus_comments ?? true) && !redirectTarget;
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  currentPath={l("/blog/")}
  canonicalHref={post.data.canonical ?? post.data.canonical_url ?? postHref}
  ogType="article"
  ogImage={post.data.thumbnail ?? siteConfig.defaultOgImage}
  articlePublishedTime={post.data.date}
  articleModifiedTime={post.data.last_updated ?? post.data.date}
  lang={locale}
  mainClass="post-content blog-post-content"
>
  {redirectTarget && <meta slot="head" http-equiv="refresh" content={`0; url=${redirectTarget}`} />}
  <script slot="head" type="application/ld+json" set:html={articleJsonLd}></script>
  <article class="post-header">
    {headerImage && <img class="post-header-image" src={headerImage} alt="" decoding="async" />}
    <div class="post-header-navigation">
      <nav class="post-breadcrumbs" aria-label="글 카테고리">
        <a href={l("/blog/")} data-i18n-key="blog_all">
          {t(locale, "blog_all")}
        </a>
        {categoryPaths[0]?.names.map((name, index) => (
          <>
            {" / "}
            <a href={l(`/blog/category/${categoryPaths[0].slugs.slice(0, index + 1).join("/")}/`)}>{name}</a>
          </>
        ))}
      </nav>
      <PostShare title={post.data.title} url={canonicalPostUrl} locale={locale} />
    </div>
    <h1>{post.data.title}</h1>
    <p class="post-byline">
      {ownerPost && authorImage && <img class="post-author-avatar" src={authorImage} alt="" width="28" height="28" />}
      <a href={l("/about/")} rel="author">
        {authorName}
      </a>
      <time datetime={post.data.date?.toISOString()}>{formatPostDate(post.data.date)}</time>
      {post.data.external_source ? ` · ${post.data.external_source}` : ""}
    </p>
  </article>

  <div class="post-detail-layout">
    <div class="post-main">
      {outline.length > 1 && (
        <details class="post-outline">
          <summary>{localeText(locale, `Contents · ${outline.length} sections`, `목차 · ${outline.length}개 항목`)}</summary>
          <ul>
            {outline.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}
      {redirectTarget && (
        <p class="notice">
          This post redirects to <a href={redirectTarget}>{redirectTarget}</a>.
        </p>
      )}

      <div class="post-body markdown-body">
        <Content />
      </div>

      {tags.length > 0 && (
        <nav class="tags post-tags" aria-label={localeText(locale, "Post tags", "글 태그")}>
          {tags.map((tag) => (
            <a href={`${l("/blog/search/")}?${new URLSearchParams({ tag })}`}>{tag.startsWith("#") ? tag : `#${tag}`}</a>
          ))}
        </nav>
      )}

      {(previousPost || nextPost) && (
        <nav class="post-pager" aria-label="Post navigation">
          {previousPost ? (
            <a
              class="post-pager-link post-pager-link--prev"
              href={previousPost.href}
              target={previousPost.external ? "_blank" : undefined}
              rel={previousPost.external ? "noreferrer" : undefined}
            >
              <span class="post-pager-label" data-i18n-key="post_previous">
                {t(locale, "post_previous")}
              </span>
              <span class="post-pager-title">{previousPost.title}</span>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )}

          {nextPost ? (
            <a
              class="post-pager-link post-pager-link--next"
              href={nextPost.href}
              target={nextPost.external ? "_blank" : undefined}
              rel={nextPost.external ? "noreferrer" : undefined}
            >
              <span class="post-pager-label" data-i18n-key="post_next">
                {t(locale, "post_next")}
              </span>
              <span class="post-pager-title">{nextPost.title}</span>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )}
        </nav>
      )}
    </div>

    {recommendedPosts.length > 0 && (
      <aside class="post-related card post-recommendations" aria-labelledby="post-related-heading">
        <h2 id="post-related-heading" data-i18n-key="post_more_to_read">
          {t(locale, "post_more_to_read")}
        </h2>
        <ul class="post-related-list">
          {recommendedPosts.map((item) => (
            <li class="post-related-item">
              <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
                <span class="post-related-copy">
                  <span class="post-related-title" title={item.title}>
                    {item.title}
                  </span>
                  <span class="post-related-meta">
                    {formatPostDate(item.date)} · {localeText(locale, `${item.readMinutes} min read`, `${item.readMinutes}분 읽기`)}
                  </span>
                </span>
                {item.gallery[0]?.startsWith("/assets/") && (
                  <img class="post-related-thumb" src={item.gallery[0]} width="48" height="48" alt="" loading="lazy" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  {showComments && (
    <section class="card post-comments">
      <h2 class="section-title">comments</h2>
      <script
        src="https://giscus.app/client.js"
        data-repo={giscusConfig.repo}
        data-repo-id={giscusConfig.repoId}
        data-category={giscusConfig.category}
        data-category-id={giscusConfig.categoryId}
        data-mapping={giscusConfig.mapping}
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </section>
  )}
</Layout>
