---
import { localeText, type Locale } from '../lib/locale';
import { postShareLinks } from '../lib/postShare';
interface Props { title: string; url: string; locale: Locale; }
const { title, url, locale } = Astro.props;
const links = postShareLinks(title, url);
const copyLabel = localeText(locale, 'Copy link', '링크 복사');
---
<div class="post-share" data-post-share data-share-url={links.url}>
  <button type="button" data-share-open aria-haspopup="dialog" aria-controls="post-share-dialog">{localeText(locale, 'Share', '공유하기')}</button>
  <button type="button" data-share-copy>{copyLabel}</button>
  <span class="post-copy-status" data-share-status role="status" aria-live="polite"></span>
  <dialog class="post-share-dialog" id="post-share-dialog" aria-labelledby="post-share-title">
    <div class="post-share-header">
      <h2 id="post-share-title">{localeText(locale, 'Share this post', '이 글 공유하기')}</h2>
      <button class="post-share-close" type="button" data-share-close aria-label={localeText(locale, 'Close sharing dialog', '공유 창 닫기')} autofocus>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
      </button>
    </div>
    <div class="post-share-content">
      <div class="post-share-options">
        <a class="post-share-choice" href={links.email}>
          <span class="post-share-icon post-share-icon--email" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg></span>
          <span>{localeText(locale, 'Email', '이메일')}</span>
        </a>
        <a class="post-share-choice" href={links.facebook} target="_blank" rel="noopener noreferrer">
          <span class="post-share-icon post-share-icon--facebook" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12a12 12 0 1 0-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.66 4.53-4.66 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.96.92-1.96 1.87V12h3.33l-.53 3.47h-2.8v8.38A12 12 0 0 0 24 12Z" /></svg></span>
          <span>Facebook</span>
        </a>
        <a class="post-share-choice" href={links.reddit} target="_blank" rel="noopener noreferrer">
          <span class="post-share-icon post-share-icon--reddit" aria-hidden="true">r/</span>
          <span>Reddit</span>
        </a>
        <a class="post-share-choice" href={links.whatsapp} target="_blank" rel="noopener noreferrer">
          <span class="post-share-icon post-share-icon--whatsapp" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.7 11.8a8.6 8.6 0 0 1-12.9 7.4L3 20.5l1.3-4.7a8.6 8.6 0 1 1 16.4-4Z" /><path fill="currentColor" stroke="none" d="M8.4 6.9c-.3-.1-.7 0-.9.3-.7.8-.7 1.8-.3 2.8.8 2.1 2.9 4.4 5.4 5.3 1.1.4 2.3.2 2.9-.6.2-.3.3-.7.2-1l-2.4-1.2-.8 1c-1.5-.6-2.7-1.8-3.4-3.3l1-.8-1.2-2.5Z" /></svg></span>
          <span>WhatsApp</span>
        </a>
        <button class="post-share-choice" type="button" data-share-copy>
          <span class="post-share-icon post-share-icon--copy" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="8" y="8" width="13" height="13" rx="2" /><path d="M5 16H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1" /></svg></span>
          <span>{copyLabel}</span>
        </button>
      </div>
      <label class="post-share-url-label" for="post-share-url">{localeText(locale, 'Post link', '글 주소')}</label>
      <input id="post-share-url" class="post-share-url" type="url" value={links.url} readonly spellcheck="false" />
      <p class="post-share-feedback" data-share-status role="status" aria-live="polite"></p>
    </div>
  </dialog>
</div>
<script>
  import { initPostShare } from '../scripts/post-share';
  document.querySelectorAll<HTMLElement>('[data-post-share]').forEach(initPostShare);
</script>
