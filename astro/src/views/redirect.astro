---
const { destination } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex, follow" /><meta http-equiv="refresh" content={`0; url=${destination}`} /><link rel="canonical" href={new URL(destination, Astro.site)} /><title>Page moved</title></head><body><p>This page has moved. <a href={destination}>Continue to the page</a>.</p></body></html>
