---
import { localeFromPath, localizedPath, localeText } from '../../lib/locale';

const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { normalizeAssetPath } from '../../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const image = normalizeAssetPath(project.data.img);
const stack = project.data.stack ?? [];
const highlights = project.data.highlights ?? [];
const lessons = project.data.lessons ?? [];
const links = project.data.links ?? [];
---

<Layout title={project.data.title} description={project.data.description ?? project.data.title} currentPath={l('/projects/')}>
  <a class="back-link" href={l('/projects/')}>{localeText(locale, 'Back to projects', '프로젝트 목록으로 돌아가기')}</a>

  <article class="project-detail-header">
    <div>
      <p class="eyebrow">{project.data.category ?? 'Project'}</p>
      <h1>{project.data.title}</h1>
      {project.data.description && <p>{project.data.description}</p>}
    </div>
  </article>

  <div class="project-detail-layout">
    <div class="project-detail-main">
      {image && <img class="project-detail-image" src={image} alt={`${project.data.title} cover`} loading="lazy" />}

      <section class="post-body markdown-body">
        <Content />
        {/* Keep older repository content visible until it is saved as an editable body. */}
        {[...highlights, ...lessons].length > 0 && (
          <ul>{[...highlights, ...lessons].map((item) => <li>{item}</li>)}</ul>
        )}
        {links.length > 0 && (
          <ul>{links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>
        )}
      </section>
    </div>

    <aside class="project-summary-panel" aria-label="Project summary">
      <dl>
        {project.data.status && (
          <>
            <dt>{localeText(locale, 'Status', '상태')}</dt>
            <dd>{project.data.status}</dd>
          </>
        )}
        {project.data.period && (
          <>
            <dt>{localeText(locale, 'Period', '기간')}</dt>
            <dd>{project.data.period}</dd>
          </>
        )}
        {project.data.role && (
          <>
            <dt>{localeText(locale, 'Role', '역할')}</dt>
            <dd>{project.data.role}</dd>
          </>
        )}
      </dl>
      {stack.length > 0 && (
        <div class="project-summary-stack">
          <h2>Stack</h2>
          <div class="project-stack">
            {stack.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Layout>
