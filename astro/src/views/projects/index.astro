---
import { localeFromPath, localizedPath, inLocale, localeText } from "../../lib/locale";
import { t } from "../../lib/messages";
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getProjectRoute, normalizeAssetPath, sortProjects } from "../../lib/content";

const pageDef = (await getCollection("pages")).find((entry) => entry.filePath?.endsWith("/projects.md"));
const allProjects = sortProjects(inLocale(await getCollection("projects"), locale));
const categories = pageDef?.data.display_categories;

const groupedProjects =
  categories && categories.length > 0
    ? [
        ...categories.map((category) => ({
          category,
          items: allProjects.filter((project) => project.data.category === category),
        })),
        { category: undefined, items: allProjects.filter((project) => !categories.includes(project.data.category ?? "")) },
      ]
    : [{ category: undefined, items: allProjects }];
const visibleGroups = groupedProjects.filter((group) => group.items.length > 0);
---

<Layout
  title={t(locale, "nav_projects")}
  description={localeText(locale, pageDef?.data.description ?? "Selected project case studies", "직접 만든 프로젝트와 실험을 둘러보세요.")}
  currentPath={l("/projects/")}
>
  <header class="page-header">
    <h1>{t(locale, "nav_projects")}</h1>
  </header>

  {visibleGroups.length === 0 && <p>{localeText(locale, "No English projects have been published yet.", "아직 한국어 프로젝트가 없습니다.")}</p>}
  {visibleGroups.map((group) => (
    <section class="project-section">
      {visibleGroups.length > 1 && group.category && <h2 class="section-title">{group.category}</h2>}
      <div class="project-list">
        {group.items.map((project) => {
          const route = getProjectRoute(project);
          const image = normalizeAssetPath(project.data.img);
          const Heading = visibleGroups.length > 1 && group.category ? "h3" : "h2";

          return (
            <article class="project-card">
              {image && (
                <div class="project-preview">
                  <img class="project-image" src={image} alt="" loading="lazy" />
                </div>
              )}
              <div class="project-content">
                {project.data.period && <p class="project-period">{project.data.period}</p>}
                <Heading>
                  <a class="project-card-link" href={route.href}>
                    {project.data.title} <span aria-hidden="true">{route.external ? "↗" : "→"}</span>
                  </a>
                </Heading>
                {project.data.description && <p class="project-description">{project.data.description}</p>}
                {!!project.data.stack?.length && <p class="project-technologies">{project.data.stack.join(" · ")}</p>}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</Layout>
