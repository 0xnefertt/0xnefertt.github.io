---
import { localeFromPath, localizedPath, localeText } from '../../lib/locale';
import { t } from '../../lib/messages';
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../components/BlogCategoryFilter.astro';
import PostCard from '../../components/PostCard.astro';
import Layout from '../../layouts/Layout.astro';
import { toSafeJson } from '../../lib/blogSearch';
import { getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../lib/blog';
import { siteConfig } from '../../lib/site';
import blogSearchScriptUrl from '../../scripts/blog-search.js?url';

const POSTS_PER_PAGE = 8;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')), locale);
const allPosts = rawPosts.map(toBlogSummary);
const categoryTree = listBlogCategoryTree(rawPosts);
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const searchConfigJson = toSafeJson([
  {
    mode: 'inline',
    indexUrl: l('/blog/search-index.json'),
    formId: 'blog-inline-search-form',
    inputId: 'blog-inline-search-input',
    resultsId: 'blog-inline-search-results',
    metaId: 'blog-inline-search-meta',
    emptyId: 'blog-inline-search-empty',
    paginationId: 'blog-pagination',
  },
]);

function getPageHref(page: number): string {
  return page <= 1 ? l('/blog/') : l(`/blog/page-${page}/`);
}
---

<Layout title="blog" description={localeText(locale, siteConfig.blogDescription, siteConfig.blogDescriptionKo)} currentPath={l('/blog/')}>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>{localeText(locale, siteConfig.blogDescription, siteConfig.blogDescriptionKo)}</p>
    <form class="blog-search-form" id="blog-inline-search-form" action={l('/blog/search/')} method="get">
      <input
        class="blog-search-input"
        id="blog-inline-search-input"
        type="search"
        name="q"
        placeholder={t(locale, 'search_placeholder')}
        aria-label="Search posts"
        data-i18n-placeholder="search_placeholder"
        autocomplete="off"
      />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">{t(locale, 'search_button')}</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={allPosts.length} isAllActive />
  </section>

  <p class="search-results-meta" id="blog-inline-search-meta" hidden></p>

  {posts.length === 0 && <p>{localeText(locale, 'No English posts have been published yet.', '아직 발행된 한국어 글이 없습니다.')}</p>}
  <ul class="post-list" id="blog-inline-search-results" style="margin-top: 1rem;">
    {
      posts.map((post) => <PostCard post={post} />)
    }
  </ul>

  <section class="card" id="blog-inline-search-empty" hidden>
    <p>{localeText(locale, 'No matching posts found.', '검색 결과가 없습니다.')}</p>
  </section>

  {
    totalPages > 1 && (
      <nav class="pagination" id="blog-pagination" aria-label="Blog pagination">
        <ul class="pagination-list">
          {currentPage > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage - 1)} data-i18n-key="pagination_prev">{t(locale, 'pagination_prev')}</a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">{t(locale, 'pagination_prev')}</span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === currentPage ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {currentPage < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage + 1)} data-i18n-key="pagination_next">{t(locale, 'pagination_next')}</a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">{t(locale, 'pagination_next')}</span>
            </li>
          )}
        </ul>
      </nav>
    )
  }

  <script is:inline define:vars={{ searchConfigJson }}>
    window.blogSearchConfigs = JSON.parse(searchConfigJson);
  </script>
  <script type="module" src={blogSearchScriptUrl}></script>
</Layout>
