---
import { localeFromPath, localizedPath, localeText } from '../../lib/locale';
import { t } from '../../lib/messages';
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import Layout from '../../layouts/Layout.astro';
import { toSafeJson } from '../../lib/blogSearch';
import { siteConfig } from '../../lib/site';
import blogSearchScriptUrl from '../../scripts/blog-search.js?url';

const searchConfigJson = toSafeJson([
  {
    mode: 'search-page',
    indexUrl: l('/blog/search-index.json'),
    formId: 'blog-search-form',
    inputId: 'blog-search-input',
    resultsId: 'blog-search-results',
    metaId: 'blog-search-meta',
    emptyId: 'blog-search-empty',
    latestLimit: 12,
  },
]);
---

<Layout title="blog search" description={localeText(locale, siteConfig.blogDescription, siteConfig.blogDescriptionKo)} currentPath={l('/blog/')} disableAds>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p data-i18n-key="search_all_posts">{t(locale, 'search_all_posts')}</p>

    <form class="blog-search-form" id="blog-search-form" action={l('/blog/search/')} method="get">
      <input
        class="blog-search-input"
        id="blog-search-input"
        type="search"
        name="q"
        placeholder={t(locale, 'search_placeholder')}
        aria-label="Search posts"
        data-i18n-placeholder="search_placeholder"
        autocomplete="off"
      />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">{t(locale, 'search_button')}</button>
    </form>

    <div class="blog-category-filter">
      <a href={l('/blog/')} class="active" data-i18n-key="search_back">{t(locale, 'search_back')}</a>
    </div>
  </section>

  <p class="search-results-meta" id="blog-search-meta"></p>

  <ul class="post-list" id="blog-search-results"></ul>

  <section class="card" id="blog-search-empty" hidden>
    <p>{localeText(locale, 'No matching posts found.', '검색 결과가 없습니다.')}</p>
  </section>

  <script is:inline define:vars={{ searchConfigJson }}>
    window.blogSearchConfigs = JSON.parse(searchConfigJson);
  </script>
  <script type="module" src={blogSearchScriptUrl}></script>
</Layout>
