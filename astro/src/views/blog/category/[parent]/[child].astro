---
import { localeFromPath, localizedPath, localeText } from '../../../../lib/locale';
import { t } from '../../../../lib/messages';
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../../../components/BlogCategoryFilter.astro';
import PostCard from '../../../../components/PostCard.astro';
import Layout from '../../../../layouts/Layout.astro';
import { getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../../../lib/blog';
import { siteConfig } from '../../../../lib/site';

const POSTS_PER_PAGE = 8;

interface Props {
  parentCategory: {
    name: string;
    slug: string;
  };
  childCategory: {
    name: string;
    slug: string;
  };
}

const { parentCategory, childCategory } = Astro.props;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')), locale);
const categoryTree = listBlogCategoryTree(rawPosts);
const allPosts = rawPosts
  .map(toBlogSummary)
  .filter((post) => post.categoryPaths.some((item) => item.parentSlug === parentCategory.slug && item.childSlug === childCategory.slug));
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const currentPage = 1;
const posts = allPosts.slice(0, POSTS_PER_PAGE);

function getPageHref(page: number): string {
  return page <= 1
    ? l(`/blog/category/${parentCategory.slug}/${childCategory.slug}/`)
    : l(`/blog/category/${parentCategory.slug}/${childCategory.slug}/page-${page}/`);
}
---

<Layout
  title={`blog · ${parentCategory.name} / ${childCategory.name}`}
  description={`Posts in ${parentCategory.name} / ${childCategory.name}`}
  currentPath={l(`/blog/category/${parentCategory.slug}/${childCategory.slug}/`)}
>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>
      {localeText(locale, 'Category', '카테고리')}: <strong>{parentCategory.name} / {childCategory.name}</strong> ({allPosts.length})
    </p>
    <form class="blog-search-form" action={l('/blog/search/')} method="get">
      <input class="blog-search-input" type="search" name="q" placeholder={t(locale, 'search_placeholder')} data-i18n-placeholder="search_placeholder" />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">{t(locale, 'search_button')}</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={rawPosts.length} activeParentSlug={parentCategory.slug} activeChildSlug={childCategory.slug} />
  </section>

  {posts.length === 0 ? (
    <section class="card">
      <p>No posts found for this category.</p>
    </section>
  ) : (
    <ul class="post-list" style="margin-top: 1rem;">
      {
        posts.map((post) => <PostCard post={post} />)
      }
    </ul>
  )}

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Category pagination">
        <ul class="pagination-list">
          {currentPage > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage - 1)} data-i18n-key="pagination_prev">{t(locale, 'pagination_prev')}</a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">{t(locale, 'pagination_prev')}</span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === currentPage ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {currentPage < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage + 1)} data-i18n-key="pagination_next">{t(locale, 'pagination_next')}</a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">{t(locale, 'pagination_next')}</span>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</Layout>
