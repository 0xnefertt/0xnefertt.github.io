---
import { localeFromPath, localizedPath, localeText } from '../../lib/locale';

const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatPostDate, normalizeTaxonomy } from '../../lib/blog';
import { normalizeAssetPath } from '../../lib/content';

interface Props {
  entry: CollectionEntry<'books'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cover = normalizeAssetPath(entry.data.cover);
const categories = normalizeTaxonomy(entry.data.categories);
const tags = normalizeTaxonomy(entry.data.tags);
---

<Layout title={entry.data.title} description={entry.data.title} currentPath={l('/books/')}>
  <article class="post-header">
    <h1>{entry.data.title}</h1>
    <p>
      {entry.data.author ? entry.data.author : 'Unknown author'}
      {entry.data.released ? ` · ${entry.data.released}` : ''}
      {entry.data.stars ? ` · ${entry.data.stars}/5` : ''}
      {entry.data.status ? ` · ${entry.data.status}` : ''}
    </p>

    {(categories.length > 0 || tags.length > 0) && (
      <div class="tags">
        {categories.map((category) => <span>{category}</span>)}
        {tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}

    {entry.data.started && <p class="book-meta">{localeText(locale, 'Started', '읽기 시작')}: {formatPostDate(entry.data.started)}</p>}
    {entry.data.finished && <p class="book-meta">{localeText(locale, 'Finished', '완독')}: {formatPostDate(entry.data.finished)}</p>}
    {entry.data.buy_link && (
      <p class="book-meta">
        <a href={entry.data.buy_link} target="_blank" rel="noreferrer">{localeText(locale, 'Buy link', '구매 링크')}</a>
      </p>
    )}
  </article>

  {cover && <img class="profile-image" src={cover} alt={`${entry.data.title} cover`} loading="lazy" />}

  <div class="post-body markdown-body">
    <Content />
  </div>
</Layout>
