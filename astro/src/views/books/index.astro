---
import { localeFromPath, localizedPath, inLocale, localeText } from "../../lib/locale";
import { t } from "../../lib/messages";
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getBookRoute, normalizeAssetPath } from "../../lib/content";
import { sortBooks } from "../../lib/books";

const books = inLocale(await getCollection("books"), locale);
const ordered = sortBooks(books).map((book) => ({ book, year: book.data.date?.getUTCFullYear() ?? "undated" }));
const years = [...new Set(ordered.map(({ year }) => year))];
---

<Layout
  title={t(locale, "nav_bookshelf")}
  description={localeText(
    locale,
    "Book reviews and reading notes: ideas, lessons, and reflections from books I have read.",
    "읽은 책의 핵심 내용과 배운 점, 생각을 정리한 독서 기록과 서평입니다."
  )}
  currentPath={l("/books/")}
>
  <header class="page-header bookshelf-header">
    <h1>{t(locale, "nav_bookshelf")}</h1>
    {years.length > 0 && (
      <label class="bookshelf-filter" hidden>
        {localeText(locale, "Review year", "기록 연도")}
        <select id="bookshelf-year" aria-controls="shelf-books">
          <option value="">{localeText(locale, "All years", "전체")}</option>
          {years.map((year) => (
            <option value={year}>{year === "undated" ? localeText(locale, "Undated", "연도 미상") : year}</option>
          ))}
        </select>
      </label>
    )}
  </header>

  {ordered.length === 0 ? (
    <p>{localeText(locale, "No English book reviews have been published yet.", "아직 한국어 독서 기록이 없습니다.")}</p>
  ) : (
    <div class="bookshelf">
      <ul class="shelf-books" id="shelf-books" role="list">
        {ordered.map(({ book, year }, index) => {
          const { title, author } = book.data;
          const cover = normalizeAssetPath(book.data.cover);
          return (
            <li data-year={year} style={`--shelf-delay: ${Math.min(index, 5) * 110}ms`}>
              <a class="shelf-book" href={getBookRoute(book).href}>
                <span class="shelf-cover" aria-hidden="true">
                  <span class="shelf-volume">
                    {cover ? (
                      <img class="shelf-jacket" src={cover} alt="" loading={index < 3 ? "eager" : "lazy"} />
                    ) : (
                      <span class="shelf-jacket shelf-cloth-cover">{title}</span>
                    )}
                  </span>
                </span>
                <span class="shelf-title">{title}</span>
              </a>
              {author && !title.includes(author) && <p class="shelf-author">{author}</p>}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</Layout>

<script>
  const filter = document.querySelector<HTMLSelectElement>("#bookshelf-year");
  if (filter) {
    const entries = document.querySelectorAll<HTMLLIElement>("#shelf-books > li");
    const applyYear = () => {
      for (const entry of entries) entry.hidden = Boolean(filter.value) && entry.dataset.year !== filter.value;
    };
    filter.closest("label")!.hidden = false;
    applyYear();
    filter.addEventListener("change", applyYear);
    window.addEventListener("pageshow", applyYear);
  }
</script>
