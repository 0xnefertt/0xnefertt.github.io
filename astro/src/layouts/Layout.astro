---
import { getNavItems, siteConfig } from '../lib/site';
import { getSocialLinks } from '../lib/data';
import { getCategoryI18nKey } from '../lib/blog';
import { localeFromPath, localizedPath, unlocalizedPath } from '../lib/locale';
import { getLanguageLinks } from '../lib/routes';
import { t } from '../lib/messages';
import Favicon from '../components/Favicon.astro';

interface Props {
  mainClass?: string;
  title?: string;
  description?: string;
  currentPath?: string;
  canonicalHref?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  noindex?: boolean;
  disableAds?: boolean;
  lang?: 'ko' | 'en';
}

function toAbsoluteCanonicalUrl(input: string): string {
  if (/^https?:\/\//.test(input)) {
    return input;
  }

  const normalized = input.startsWith('/') ? input : `/${input}`;
  return new URL(normalized, siteConfig.siteUrl).toString();
}

const {
  mainClass,
  title,
  description = siteConfig.description,
  currentPath = '/',
  canonicalHref,
  ogType = 'website',
  ogImage = siteConfig.defaultOgImage,
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  disableAds = false,
  lang = localeFromPath(Astro.url.pathname),
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const l = (path: string) => localizedPath(path, locale);
const languageLinks = await getLanguageLinks(Astro.url.pathname);
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = canonicalHref ? toAbsoluteCanonicalUrl(canonicalHref) : new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const isBlogPaginationPage = /^\/blog\/(?:page-\d+|category\/[^/]+(?:\/[^/]+)?\/page-\d+)\/?$/.test(unlocalizedPath(Astro.url.pathname));
const shouldNoindex = noindex || unlocalizedPath(Astro.url.pathname) === '/blog/search/' || isBlogPaginationPage;
const currentYear = new Date().getFullYear();
const navItems = await getNavItems(locale);
const socialLinks = (await getSocialLinks()).filter((item) => item.label !== 'rss');
const socialLabels: Record<string, string> = { email: 'Email', github: 'GitHub', x: 'X' };
const gaMeasurementId = siteConfig.gaMeasurementId?.trim() ?? '';
const hasGaMeasurementId = gaMeasurementId.length > 0;
const shouldLoadAds = siteConfig.adsensePublisherId.length > 0 && !disableAds;

function toAbsoluteUrl(input: string): string {
  if (/^https?:\/\//.test(input)) {
    return input;
  }

  const normalized = input.startsWith('/') ? input : `/${input}`;
  return new URL(normalized, siteConfig.siteUrl).toString();
}

function toIsoDate(value?: Date | string): string | undefined {
  if (!value) {
    return undefined;
  }

  const normalized = value instanceof Date ? value : new Date(value);
  return Number.isNaN(normalized.getTime()) ? undefined : normalized.toISOString();
}

const socialImage = toAbsoluteUrl(ogImage);
const articlePublishedIso = toIsoDate(articlePublishedTime);
const articleModifiedIso = toIsoDate(articleModifiedTime);

function isActive(href: string, path: string): boolean {
  if (href === '/') {
    return path === '/';
  }

  return path === href || path.startsWith(href);
}

function getNavI18nKey(href: string): string | undefined {
  const map: Record<string, string> = {
    '/about/': 'nav_about',
    '/blog/': 'nav_blog',
    '/books/': 'nav_bookshelf',
    '/projects/': 'nav_projects',
  };

  return map[unlocalizedPath(href)];
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicon />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {languageLinks.filter((link) => link.translated).map((link) => <link rel="alternate" hreflang={link.locale} href={new URL(link.href, siteConfig.siteUrl)} />)}
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS Feed`} href={l('/rss.xml')} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    {ogType === 'article' && articlePublishedIso && <meta property="article:published_time" content={articlePublishedIso} />}
    {ogType === 'article' && articleModifiedIso && <meta property="article:modified_time" content={articleModifiedIso} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:site" content={siteConfig.xHandle} />
    <meta name="twitter:creator" content={siteConfig.xHandle} />
    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];
        window.gtag =
          window.gtag ||
          function gtag() {
            window.dataLayer.push(arguments);
          };

        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 2000,
        });
        window.gtag('set', 'ads_data_redaction', true);
      })();
    </script>
    {
      hasGaMeasurementId && (
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      )
    }
    {
      hasGaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.gtag('js', new Date());
          window.gtag('config', gaMeasurementId);
        </script>
      )
    }
    <script is:inline define:vars={{ gaMeasurementId }}>
      (() => {
        const analytics = window.siteAnalytics || {};
        analytics.track =
          analytics.track ||
          function track(eventName, params = {}) {
            if (!gaMeasurementId || typeof window.gtag !== 'function') {
              return;
            }

            window.gtag('event', eventName, params);
          };
        window.siteAnalytics = analytics;
      })();
    </script>
    {
      shouldLoadAds && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
          crossorigin="anonymous"
        ></script>
      )
    }
    <slot name="head" />
    <script is:inline>
      (() => {
        const STORAGE_KEY = 'site-theme';
        const storedTheme = localStorage.getItem(STORAGE_KEY);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : prefersDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/assets/styles/global.css?v=20261010-1" />
    <link rel="stylesheet" href="/assets/styles/blog.css?v=20261010-5" />
  </head>
  <body class="site-layout">
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-title" href={l('/')}>{siteConfig.title}</a>
        <button
          type="button"
          class="menu-toggle"
          data-menu-toggle
          aria-controls="site-menu-panel"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <span class="menu-toggle-icon" aria-hidden="true"></span>
          <span>{t(locale, 'nav_menu')}</span>
        </button>
        <div class="header-controls" id="site-menu-panel">
          <nav aria-label="Primary" id="primary-nav">
            <ul class="nav-list">
              {
                navItems.map((item) => (
                  <li class={item.children && item.children.length > 0 ? 'nav-item nav-item--dropdown' : 'nav-item'}>
                    <a class={isActive(item.href, currentPath) ? 'active' : undefined} href={item.href} data-i18n-key={getNavI18nKey(item.href)}>
                      {getNavI18nKey(item.href) ? t(locale, getNavI18nKey(item.href)!) : item.label}
                    </a>
                    {item.children && item.children.length > 0 && (
                      <ul class="nav-dropdown">
                        {item.children.map((child) => (
                          <li class={child.children && child.children.length > 0 ? 'nav-dropdown-item nav-dropdown-item--nested' : 'nav-dropdown-item'}>
                            <a class={isActive(child.href, currentPath) ? 'active' : undefined} href={child.href} data-i18n-key={getCategoryI18nKey(child.href)}>
                              {getCategoryI18nKey(child.href) ? t(locale, getCategoryI18nKey(child.href)!) : child.label}
                            </a>
                            {child.children && child.children.length > 0 && (
                              <ul class="nav-subdropdown">
                                {child.children.map((grandchild) => (
                                  <li>
                                    <a
                                      class={isActive(grandchild.href, currentPath) ? 'active' : undefined}
                                      href={grandchild.href}
                                      data-i18n-key={getCategoryI18nKey(grandchild.href)}
                                    >
                                      {getCategoryI18nKey(grandchild.href) ? t(locale, getCategoryI18nKey(grandchild.href)!) : grandchild.label}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="preference-controls">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">
              <span class="theme-toggle-icon" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class:list={['container', mainClass]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          © {currentYear} 0xnefertt.
        </p>
        <div class="footer-links">
          <nav aria-label="Site links">
            <ul class="footer-site-links">
              <li><a href={l('/privacy/')}>Privacy</a></li>
              <li><a href="/admin/">Login</a></li>
              <li><a href={l('/rss.xml')} type="application/rss+xml">RSS</a></li>
              {socialLinks.map((item) => <li><a href={item.href}>{socialLabels[item.label] ?? item.label}</a></li>)}
              <li>
                <div class="language-switch" role="group" aria-label="Language selector">
                  <a class:list={['language-option', { 'is-active': locale === 'en' }]} href={languageLinks[0].href} aria-current={locale === 'en' ? 'page' : undefined} title={languageLinks[0].translated ? 'English' : 'English version not published; opens English index'}>EN</a>
                  <span aria-hidden="true">|</span>
                  <a class:list={['language-option', { 'is-active': locale === 'ko' }]} href={languageLinks[1].href} aria-current={locale === 'ko' ? 'page' : undefined} title={languageLinks[1].translated ? '한국어' : '한국어 번역이 없어 목록으로 이동합니다'}>KR</a>
                </div>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ gaMeasurementId }}>
      (() => {
        function track(eventName, params = {}) {
          if (!gaMeasurementId || typeof window.gtag !== 'function') {
            return;
          }

          window.gtag('event', eventName, params);
        }

        window.siteAnalytics = {
          track,
        };

        const pagePath = window.location.pathname;
        if (/^\/blog\/\d{4}\//.test(pagePath)) {
          track('post_opened', {
            page_path: pagePath,
            page_title: document.title,
          });
        }

        document.addEventListener('click', (event) => {
          const clickTarget = event.target;
          if (!(clickTarget instanceof Element)) {
            return;
          }

          const anchor = clickTarget.closest('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) {
            return;
          }

          if (anchor.dataset.trackIgnore === 'true') {
            return;
          }

          const href = anchor.getAttribute('href');
          if (!href) {
            return;
          }

          let url;
          try {
            url = new URL(href, window.location.href);
          } catch {
            return;
          }

          if (url.origin === window.location.origin) {
            return;
          }

          track('outbound_click', {
            destination_url: url.toString(),
            link_text: (anchor.textContent || '').trim().slice(0, 120),
            page_path: pagePath,
          });
        });

        let sentAdPlaceholder = false;
        const sendAdPlaceholderEvent = () => {
          if (sentAdPlaceholder) {
            return;
          }

          sentAdPlaceholder = true;
          track('adsense_script_present_engagement', {
            page_path: pagePath,
          });
        };

        const hasAdSenseScript = Boolean(document.querySelector('script[src*="googlesyndication.com/pagead/js/adsbygoogle.js"]'));
        if (!hasAdSenseScript) {
          return;
        }

        setTimeout(sendAdPlaceholderEvent, 45000);
        window.addEventListener(
          'scroll',
          () => {
            const doc = document.documentElement;
            const scrollableHeight = Math.max(doc.scrollHeight - window.innerHeight, 1);
            const ratio = window.scrollY / scrollableHeight;

            if (ratio >= 0.55) {
              sendAdPlaceholderEvent();
            }
          },
          { passive: true }
        );
      })();
    </script>

    <script is:inline>
      (() => {
        const STORAGE_KEY = 'site-theme';
        const themeToggle = document.querySelector('[data-theme-toggle]');

        if (!(themeToggle instanceof HTMLButtonElement)) {
          return;
        }

        function getCurrentTheme() {
          return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        }

        function applyTheme(nextTheme) {
          document.documentElement.dataset.theme = nextTheme;
          localStorage.setItem(STORAGE_KEY, nextTheme);
          const isDark = nextTheme === 'dark';
          themeToggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        }

        applyTheme(getCurrentTheme());

        themeToggle.addEventListener('click', () => {
          applyTheme(getCurrentTheme() === 'dark' ? 'light' : 'dark');
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const header = document.querySelector('.site-header');
        const menuToggle = document.querySelector('[data-menu-toggle]');
        const menuPanel = document.getElementById('site-menu-panel');

        if (!(header instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement) || !(menuPanel instanceof HTMLElement)) {
          return;
        }

        const mobileMedia = window.matchMedia('(max-width: 840px)');

        function setMenuOpen(nextOpen) {
          header.classList.toggle('menu-open', nextOpen);
          menuToggle.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
          menuToggle.setAttribute('aria-label', nextOpen ? 'Close navigation menu' : 'Open navigation menu');
        }

        function closeMenu() {
          setMenuOpen(false);
        }

        menuToggle.addEventListener('click', () => {
          const willOpen = !header.classList.contains('menu-open');
          setMenuOpen(willOpen);
        });

        menuPanel.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) {
            return;
          }

          if (target.closest('a[href]') && mobileMedia.matches) {
            closeMenu();
          }
        });

        document.addEventListener('click', (event) => {
          if (!mobileMedia.matches) {
            return;
          }

          const target = event.target;
          if (!(target instanceof Node)) {
            return;
          }

          if (header.contains(target)) {
            return;
          }

          closeMenu();
        });

        mobileMedia.addEventListener('change', () => {
          if (!mobileMedia.matches) {
            closeMenu();
          }
        });
      })();
    </script>


  </body>
</html>
