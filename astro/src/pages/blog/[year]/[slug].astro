---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostDetail from '../../../components/PostDetail.astro';
import { getPostCategoryPaths, getPostRoute, getPublishedBlogPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = getPublishedBlogPosts(await getCollection('blog'));

  return posts
    .filter((post) => !getPostCategoryPaths(post).some((categoryPath) => categoryPath.childSlug))
    .map((post) => {
      const route = getPostRoute(post);

      return {
        params: {
          year: route.year,
          slug: route.slug,
        },
        props: {
          post,
        },
      };
    });
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<PostDetail post={post} />
