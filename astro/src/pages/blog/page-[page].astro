---
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../components/BlogCategoryFilter.astro';
import PostCard from '../../components/PostCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../lib/blog';
import { siteConfig } from '../../lib/site';

export async function getStaticPaths() {
  const postsPerPage = 8;
  const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
  const totalPages = Math.max(1, Math.ceil(rawPosts.length / postsPerPage));

  return Array.from({ length: totalPages }, (_, index) => index + 1)
    .filter((page) => page > 1)
    .map((page) => ({
      params: { page: String(page) },
      props: { currentPage: page },
    }));
}

interface Props {
  currentPage: number;
}

const { currentPage } = Astro.props;
const postsPerPage = 8;

const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
const allPosts = rawPosts.map(toBlogSummary);
const categoryTree = listBlogCategoryTree(rawPosts);
const totalPages = Math.max(1, Math.ceil(allPosts.length / postsPerPage));
const pageIndex = Math.max(1, Math.min(currentPage, totalPages));
const pageStart = (pageIndex - 1) * postsPerPage;
const posts = allPosts.slice(pageStart, pageStart + postsPerPage);

function getPageHref(page: number): string {
  return page <= 1 ? '/blog/' : `/blog/page-${page}/`;
}
---

<Layout title={`blog · page ${pageIndex}`} description={siteConfig.blogDescription} currentPath="/blog/">
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>
      {siteConfig.blogDescription} · Page {pageIndex} of {totalPages}
    </p>
    <form class="blog-search-form" action="/blog/search/" method="get">
      <input class="blog-search-input" type="search" name="q" placeholder="Search posts" data-i18n-placeholder="search_placeholder" />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">Search</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={allPosts.length} isAllActive />
  </section>

  <ul class="post-list" style="margin-top: 1rem;">
    {
      posts.map((post) => <PostCard post={post} />)
    }
  </ul>

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Blog pagination">
        <ul class="pagination-list">
          {pageIndex > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(pageIndex - 1)} data-i18n-key="pagination_prev">
                Previous
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">
                Previous
              </span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === pageIndex ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {pageIndex < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(pageIndex + 1)} data-i18n-key="pagination_next">
                Next
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">
                Next
              </span>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</Layout>
