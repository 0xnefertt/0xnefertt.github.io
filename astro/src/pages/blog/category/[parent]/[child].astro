---
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../../../components/BlogCategoryFilter.astro';
import PostCard from '../../../../components/PostCard.astro';
import Layout from '../../../../layouts/Layout.astro';
import { getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../../../lib/blog';
import { siteConfig } from '../../../../lib/site';

const POSTS_PER_PAGE = 8;

export async function getStaticPaths() {
  const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
  const categoryTree = listBlogCategoryTree(rawPosts);

  return categoryTree.flatMap((parentCategory) =>
    parentCategory.children.map((childCategory) => ({
      params: {
        parent: parentCategory.slug,
        child: childCategory.slug,
      },
      props: {
        parentCategory: {
          name: parentCategory.name,
          slug: parentCategory.slug,
        },
        childCategory: {
          name: childCategory.name,
          slug: childCategory.slug,
        },
      },
    }))
  );
}

interface Props {
  parentCategory: {
    name: string;
    slug: string;
  };
  childCategory: {
    name: string;
    slug: string;
  };
}

const { parentCategory, childCategory } = Astro.props;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
const categoryTree = listBlogCategoryTree(rawPosts);
const allPosts = rawPosts
  .map(toBlogSummary)
  .filter((post) => post.categoryPaths.some((item) => item.parentSlug === parentCategory.slug && item.childSlug === childCategory.slug));
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const currentPage = 1;
const posts = allPosts.slice(0, POSTS_PER_PAGE);

function getPageHref(page: number): string {
  return page <= 1
    ? `/blog/category/${parentCategory.slug}/${childCategory.slug}/`
    : `/blog/category/${parentCategory.slug}/${childCategory.slug}/page-${page}/`;
}
---

<Layout
  title={`blog · ${parentCategory.name} / ${childCategory.name}`}
  description={`Posts in ${parentCategory.name} / ${childCategory.name}`}
  currentPath={`/blog/category/${parentCategory.slug}/${childCategory.slug}/`}
>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>
      Category: <strong>{parentCategory.name} / {childCategory.name}</strong> ({allPosts.length})
    </p>
    <form class="blog-search-form" action="/blog/search/" method="get">
      <input class="blog-search-input" type="search" name="q" placeholder="Search posts" data-i18n-placeholder="search_placeholder" />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">Search</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={rawPosts.length} activeParentSlug={parentCategory.slug} activeChildSlug={childCategory.slug} />
  </section>

  {posts.length === 0 ? (
    <section class="card">
      <p>No posts found for this category.</p>
    </section>
  ) : (
    <ul class="post-list" style="margin-top: 1rem;">
      {
        posts.map((post) => <PostCard post={post} />)
      }
    </ul>
  )}

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Category pagination">
        <ul class="pagination-list">
          {currentPage > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage - 1)} data-i18n-key="pagination_prev">
                Previous
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">
                Previous
              </span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === currentPage ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {currentPage < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage + 1)} data-i18n-key="pagination_next">
                Next
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">
                Next
              </span>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</Layout>
