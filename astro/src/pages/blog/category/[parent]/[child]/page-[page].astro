---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import { formatPostDate, getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../../../../lib/blog';
import { siteConfig } from '../../../../../lib/site';

export async function getStaticPaths() {
  const postsPerPage = 8;
  const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
  const categoryTree = listBlogCategoryTree(rawPosts);
  const summaries = rawPosts.map(toBlogSummary);

  return categoryTree.flatMap((parentCategory) =>
    parentCategory.children.flatMap((childCategory) => {
      const categoryPostCount = summaries.filter(
        (post) => post.categoryPaths.some((item) => item.parentSlug === parentCategory.slug && item.childSlug === childCategory.slug)
      ).length;

      const totalPages = Math.max(1, Math.ceil(categoryPostCount / postsPerPage));

      return Array.from({ length: totalPages }, (_, index) => index + 1)
        .filter((page) => page > 1)
        .map((page) => ({
          params: {
            parent: parentCategory.slug,
            child: childCategory.slug,
            page: String(page),
          },
          props: {
            parentCategory: {
              name: parentCategory.name,
              slug: parentCategory.slug,
            },
            childCategory: {
              name: childCategory.name,
              slug: childCategory.slug,
            },
            currentPage: page,
          },
        }));
    })
  );
}

interface Props {
  parentCategory: {
    name: string;
    slug: string;
  };
  childCategory: {
    name: string;
    slug: string;
  };
  currentPage: number;
}

const { parentCategory, childCategory, currentPage } = Astro.props;
const postsPerPage = 8;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
const categoryTree = listBlogCategoryTree(rawPosts);
const allPosts = rawPosts
  .map(toBlogSummary)
  .filter((post) => post.categoryPaths.some((item) => item.parentSlug === parentCategory.slug && item.childSlug === childCategory.slug));
const totalPages = Math.max(1, Math.ceil(allPosts.length / postsPerPage));
const pageIndex = Math.max(1, Math.min(currentPage, totalPages));
const pageStart = (pageIndex - 1) * postsPerPage;
const posts = allPosts.slice(pageStart, pageStart + postsPerPage);

function getPageHref(page: number): string {
  return page <= 1
    ? `/blog/category/${parentCategory.slug}/${childCategory.slug}/`
    : `/blog/category/${parentCategory.slug}/${childCategory.slug}/page-${page}/`;
}
---

<Layout
  title={`blog · ${parentCategory.name} / ${childCategory.name} · page ${pageIndex}`}
  description={`Posts in ${parentCategory.name} / ${childCategory.name}`}
  currentPath={`/blog/category/${parentCategory.slug}/${childCategory.slug}/`}
>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>
      Category: <strong>{parentCategory.name} / {childCategory.name}</strong> ({allPosts.length}) · Page {pageIndex} of {totalPages}
    </p>
    <form class="blog-search-form" action="/blog/search/" method="get">
      <input class="blog-search-input" type="search" name="q" placeholder="Search posts" data-i18n-placeholder="search_placeholder" />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">Search</button>
    </form>
    <nav class="blog-category-filter" aria-label="Blog categories">
      <ul class="blog-category-parent-list">
        <li><a href="/blog/">all</a></li>
        {
          categoryTree.map((parent) => (
            <li class="blog-category-parent-item">
              <a href={parent.href} class={parent.slug === parentCategory.slug ? 'active' : undefined}>
                {parent.name}
              </a>
              {parent.children.length > 0 && (
                <ul class="blog-category-child-list">
                  {
                    parent.children.map((child) => (
                      <li>
                        <a href={child.href} class={parent.slug === parentCategory.slug && child.slug === childCategory.slug ? 'active' : undefined}>
                          {child.name}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  {posts.length === 0 ? (
    <section class="card">
      <p>No posts found for this category.</p>
    </section>
  ) : (
    <ul class="post-list" style="margin-top: 1rem;">
      {
        posts.map((post) => (
          <li class="post-item">
            <h2>
              <a href={post.href} target={post.external ? '_blank' : undefined} rel={post.external ? 'noreferrer' : undefined}>
                {post.title}
              </a>
            </h2>
            <p class="post-meta">
              {formatPostDate(post.date)} · {post.readMinutes} min read
              {post.externalSource ? ` · ${post.externalSource}` : ''}
            </p>
            {post.description && <p>{post.description}</p>}

            {(post.tags.length > 0 || post.categoryPaths.length > 0) && (
              <div class="tags">
                {post.tags.map((tag) => <span>#{tag}</span>)}
                {post.categoryPaths.map((categoryPath) => <a href={categoryPath.href}>{categoryPath.label}</a>)}
              </div>
            )}

          </li>
        ))
      }
    </ul>
  )}

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Category pagination">
        <ul class="pagination-list">
          {pageIndex > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(pageIndex - 1)} data-i18n-key="pagination_prev">
                Previous
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">
                Previous
              </span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === pageIndex ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {pageIndex < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(pageIndex + 1)} data-i18n-key="pagination_next">
                Next
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">
                Next
              </span>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</Layout>
