---
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../../components/BlogCategoryFilter.astro';
import Layout from '../../../layouts/Layout.astro';
import { formatPostDate, getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../../lib/blog';
import { siteConfig } from '../../../lib/site';

const POSTS_PER_PAGE = 8;

export async function getStaticPaths() {
  const posts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
  const categories = listBlogCategoryTree(posts);

  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: {
    name: string;
    slug: string;
    count: number;
  };
}

const { category } = Astro.props;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
const categoryTree = listBlogCategoryTree(rawPosts);
const allPosts = rawPosts.map(toBlogSummary).filter((post) => post.categoryPaths.some((item) => item.parentSlug === category.slug));
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const currentPage = 1;
const posts = allPosts.slice(0, POSTS_PER_PAGE);

function getPageHref(page: number): string {
  return page <= 1 ? `/blog/category/${category.slug}/` : `/blog/category/${category.slug}/page-${page}/`;
}
---

<Layout title={`blog · ${category.name}`} description={`Posts in ${category.name}`} currentPath={`/blog/category/${category.slug}/`}>
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>
      Category: <strong>{category.name}</strong> ({allPosts.length})
    </p>
    <form class="blog-search-form" action="/blog/search/" method="get">
      <input class="blog-search-input" type="search" name="q" placeholder="Search posts" data-i18n-placeholder="search_placeholder" />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">Search</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={rawPosts.length} activeParentSlug={category.slug} />
  </section>

  {posts.length === 0 ? (
    <section class="card">
      <p>No posts found for this category.</p>
    </section>
  ) : (
    <ul class="post-list" style="margin-top: 1rem;">
      {
        posts.map((post) => (
          <li class="post-item">
            <h2>
              <a href={post.href} target={post.external ? '_blank' : undefined} rel={post.external ? 'noreferrer' : undefined}>
                {post.title}
              </a>
            </h2>
            <p class="post-meta">
              {formatPostDate(post.date)} · {post.readMinutes} min read
              {post.externalSource ? ` · ${post.externalSource}` : ''}
            </p>
            {post.description && <p>{post.description}</p>}

            {(post.tags.length > 0 || post.categoryPaths.length > 0) && (
              <div class="tags">
                {post.tags.map((tag) => <span>#{tag}</span>)}
                {post.categoryPaths.map((categoryPath) => <a href={categoryPath.href}>{categoryPath.label}</a>)}
              </div>
            )}

          </li>
        ))
      }
    </ul>
  )}

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Category pagination">
        <ul class="pagination-list">
          {currentPage > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage - 1)} data-i18n-key="pagination_prev">
                Previous
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">
                Previous
              </span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === currentPage ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {currentPage < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage + 1)} data-i18n-key="pagination_next">
                Next
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">
                Next
              </span>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</Layout>
