---
import { getCollection } from 'astro:content';
import BlogCategoryFilter from '../../components/BlogCategoryFilter.astro';
import Layout from '../../layouts/Layout.astro';
import { formatPostDate, getPublishedBlogPosts, listBlogCategoryTree, sortPostsDesc, toBlogSummary } from '../../lib/blog';
import { siteConfig } from '../../lib/site';

const POSTS_PER_PAGE = 8;
const rawPosts = getPublishedBlogPosts(sortPostsDesc(await getCollection('blog')));
const allPosts = rawPosts.map(toBlogSummary);
const categoryTree = listBlogCategoryTree(rawPosts);
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);

function normalizeMarkdownForSearch(content: string): string {
  return content
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_~\-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 14000);
}

const searchIndex = rawPosts.map((entry) => {
  const post = toBlogSummary(entry);

  return {
    title: post.title,
    description: post.description ?? '',
    content: normalizeMarkdownForSearch(entry.body ?? ''),
    href: post.href,
    external: post.external,
    externalSource: post.externalSource ?? '',
    readMinutes: post.readMinutes,
    dateLabel: formatPostDate(post.date),
    dateValue: post.date?.getTime() ?? 0,
    tags: post.tags,
    categoryPaths: post.categoryPaths.map((categoryPath) => ({
      href: categoryPath.href,
      label: categoryPath.label,
    })),
    categories: post.categories,
  };
});

const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

function getPageHref(page: number): string {
  return page <= 1 ? '/blog/' : `/blog/page-${page}/`;
}
---

<Layout title="blog" description={siteConfig.blogDescription} currentPath="/blog/">
  <section class="blog-header">
    <h1>{siteConfig.blogName}</h1>
    <p>{siteConfig.blogDescription}</p>
    <form class="blog-search-form" id="blog-inline-search-form" action="/blog/search/" method="get">
      <input
        class="blog-search-input"
        id="blog-inline-search-input"
        type="search"
        name="q"
        placeholder="Search posts"
        data-i18n-placeholder="search_placeholder"
        autocomplete="off"
      />
      <button class="blog-search-button" type="submit" data-i18n-key="search_button">Search</button>
    </form>
    <BlogCategoryFilter categoryTree={categoryTree} totalCount={allPosts.length} isAllActive />
  </section>

  <p class="search-results-meta" id="blog-inline-search-meta" hidden></p>

  <ul class="post-list" id="blog-inline-search-results" style="margin-top: 1rem;">
    {
      posts.map((post) => (
        <li class="post-item">
          <h2>
            <a href={post.href} target={post.external ? '_blank' : undefined} rel={post.external ? 'noreferrer' : undefined}>
              {post.title}
            </a>
          </h2>
          <p class="post-meta">
            {formatPostDate(post.date)} · {post.readMinutes} min read
            {post.externalSource ? ` · ${post.externalSource}` : ''}
          </p>
          {post.description && <p>{post.description}</p>}

          {(post.tags.length > 0 || post.categoryPaths.length > 0) && (
            <div class="tags">
              {post.tags.map((tag) => <span>#{tag}</span>)}
              {post.categoryPaths.map((categoryPath) => <a href={categoryPath.href}>{categoryPath.label}</a>)}
            </div>
          )}

        </li>
      ))
    }
  </ul>

  <section class="card" id="blog-inline-search-empty" hidden>
    <p>No matching posts found.</p>
  </section>

  {
    totalPages > 1 && (
      <nav class="pagination" id="blog-pagination" aria-label="Blog pagination">
        <ul class="pagination-list">
          {currentPage > 1 ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage - 1)} data-i18n-key="pagination_prev">
                Previous
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_prev">
                Previous
              </span>
            </li>
          )}

          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a class={page === currentPage ? 'pagination-link active' : 'pagination-link'} href={getPageHref(page)}>
                {page}
              </a>
            </li>
          ))}

          {currentPage < totalPages ? (
            <li>
              <a class="pagination-link" href={getPageHref(currentPage + 1)} data-i18n-key="pagination_next">
                Next
              </a>
            </li>
          ) : (
            <li>
              <span class="pagination-link pagination-link--disabled" data-i18n-key="pagination_next">
                Next
              </span>
            </li>
          )}
        </ul>
      </nav>
    )
  }

  <script id="blog-inline-search-data" type="application/json" set:html={searchIndexJson}></script>

  <script is:inline>
    (() => {
      const dataNode = document.getElementById('blog-inline-search-data');
      const form = document.getElementById('blog-inline-search-form');
      const input = document.getElementById('blog-inline-search-input');
      const resultsContainer = document.getElementById('blog-inline-search-results');
      const metaNode = document.getElementById('blog-inline-search-meta');
      const emptyNode = document.getElementById('blog-inline-search-empty');
      const paginationNode = document.getElementById('blog-pagination');

      if (!(dataNode instanceof HTMLScriptElement) || !(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) {
        return;
      }

      if (!(resultsContainer instanceof HTMLUListElement) || !(metaNode instanceof HTMLParagraphElement) || !(emptyNode instanceof HTMLElement)) {
        return;
      }

      let posts = [];

      try {
        posts = JSON.parse(dataNode.textContent || '[]');
      } catch {
        posts = [];
      }

      const initialResultsHtml = resultsContainer.innerHTML;

      const trackSearch = (query, resultCount, source) => {
        const normalizedQuery = String(query || '').trim();
        if (!normalizedQuery) {
          return;
        }

        const analytics = window.siteAnalytics;
        if (!analytics || typeof analytics.track !== 'function') {
          return;
        }

        analytics.track('search_used', {
          search_query: normalizedQuery.slice(0, 120),
          results_count: resultCount,
          source,
          page_path: window.location.pathname,
        });
      };

      const normalize = (value) =>
        String(value || '')
          .toLowerCase()
          .replace(/[^a-z0-9\s가-힣-]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();

      const buildHaystack = (post) =>
        normalize([post.title, post.description, post.content, ...(post.tags || []), ...(post.categories || [])].join(' '));

      const scorePost = (post, query) => {
        const title = normalize(post.title);
        const description = normalize(post.description);
        const content = normalize(post.content);
        const tags = normalize((post.tags || []).join(' '));
        const categories = normalize((post.categories || []).join(' '));
        const haystack = buildHaystack(post);

        let score = 0;
        if (title.includes(query)) score += 8;
        if (description.includes(query)) score += 4;
        if (content.includes(query)) score += 3;
        if (tags.includes(query)) score += 3;
        if (categories.includes(query)) score += 3;
        if (haystack.includes(query)) score += 1;

        return score;
      };

      const createPostItem = (post) => {
        const item = document.createElement('li');
        item.className = 'post-item';

        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = post.href;
        link.textContent = post.title;
        if (post.external) {
          link.target = '_blank';
          link.rel = 'noreferrer';
        }

        heading.appendChild(link);
        item.appendChild(heading);

        const meta = document.createElement('p');
        meta.className = 'post-meta';
        meta.textContent = `${post.dateLabel} · ${post.readMinutes} min read${post.externalSource ? ` · ${post.externalSource}` : ''}`;
        item.appendChild(meta);

        if (post.description) {
          const description = document.createElement('p');
          description.textContent = post.description;
          item.appendChild(description);
        }

        const tags = Array.isArray(post.tags) ? post.tags : [];
        const categoryPaths = Array.isArray(post.categoryPaths) ? post.categoryPaths : [];

        if (tags.length > 0 || categoryPaths.length > 0) {
          const tagContainer = document.createElement('div');
          tagContainer.className = 'tags';

          for (const tag of tags) {
            const tagNode = document.createElement('span');
            tagNode.textContent = `#${tag}`;
            tagContainer.appendChild(tagNode);
          }

          for (const categoryPath of categoryPaths) {
            const categoryNode = document.createElement('a');
            categoryNode.href = categoryPath.href;
            categoryNode.textContent = categoryPath.label;
            tagContainer.appendChild(categoryNode);
          }

          item.appendChild(tagContainer);
        }

        return item;
      };

      const renderSearchResults = (items, rawQuery) => {
        resultsContainer.textContent = '';

        for (const post of items) {
          resultsContainer.appendChild(createPostItem(post));
        }

        metaNode.hidden = false;
        metaNode.textContent = `${items.length} result${items.length === 1 ? '' : 's'} for "${rawQuery.trim()}".`;
        emptyNode.hidden = items.length > 0;
        if (paginationNode) {
          paginationNode.hidden = true;
        }
      };

      const restoreDefaultList = () => {
        resultsContainer.innerHTML = initialResultsHtml;
        metaNode.hidden = true;
        metaNode.textContent = '';
        emptyNode.hidden = true;
        if (paginationNode) {
          paginationNode.hidden = false;
        }
      };

      const updateUrl = (query) => {
        const nextUrl = new URL(window.location.href);
        if (query) {
          nextUrl.searchParams.set('q', query);
        } else {
          nextUrl.searchParams.delete('q');
        }
        window.history.replaceState(null, '', nextUrl);
      };

      const runSearch = (rawQuery, mutateUrl = false) => {
        const query = normalize(rawQuery);

        if (mutateUrl) {
          updateUrl(rawQuery.trim());
        }

        if (!query) {
          restoreDefaultList();
          return 0;
        }

        const matches = posts
          .map((post) => ({
            post,
            score: scorePost(post, query),
          }))
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score || (b.post.dateValue || 0) - (a.post.dateValue || 0))
          .map((item) => item.post);

        renderSearchResults(matches, rawQuery);
        return matches.length;
      };

      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get('q') || '';
      input.value = initialQuery;
      const initialCount = runSearch(initialQuery, false);
      if (initialQuery.trim()) {
        trackSearch(initialQuery, initialCount, 'page_load');
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const resultCount = runSearch(input.value, true);
        trackSearch(input.value, resultCount, 'submit');
      });

      input.addEventListener('input', () => {
        runSearch(input.value, true);
      });
    })();
  </script>
</Layout>
