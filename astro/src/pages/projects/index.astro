---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjectRoute, normalizeAssetPath, sortProjects } from '../../lib/content';

const pageDef = (await getCollection('pages')).find((entry) => entry.filePath?.endsWith('/projects.md'));
const allProjects = sortProjects(await getCollection('projects'));
const categories = pageDef?.data.display_categories;

const groupedProjects =
  categories && categories.length > 0
    ? categories.map((category) => ({
        category,
        items: allProjects.filter((project) => project.data.category === category),
      }))
    : [{ category: undefined, items: allProjects }];
const visibleGroups = groupedProjects.filter((group) => group.items.length > 0);
---

<Layout title="projects" description={pageDef?.data.description ?? 'Selected project case studies'} currentPath="/projects/">
  <section class="page-header project-portfolio-header">
    <p class="eyebrow">Portfolio</p>
    <h1>Projects</h1>
    <p>{pageDef?.data.description ?? 'A curated collection of things I built, improved, and learned from.'}</p>
  </section>

  {
    visibleGroups.map((group) => (
      <section class="project-section">
        {group.category && <h2 class="section-title">{group.category}</h2>}
        <div class="project-grid">
          {group.items.map((project) => {
            const route = getProjectRoute(project);
            const image = normalizeAssetPath(project.data.img);

            return (
              <article class="project-card">
                <a class="project-card-link" href={route.href} target={route.external ? '_blank' : undefined} rel={route.external ? 'noreferrer' : undefined}>
                  {image && <img class="project-image" src={image} alt={`${project.data.title} thumbnail`} loading="lazy" />}
                  <div class="project-content">
                    <h2>{project.data.title}</h2>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</Layout>
