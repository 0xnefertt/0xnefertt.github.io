---
import editor from '../../../writer/src/editor.html?raw';
const backend = new URL(import.meta.env.PUBLIC_WRITER_URL?.trim() || 'https://nefertt-writer.0xnefertt-writer.workers.dev').origin;
const policy = `default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: blob:; connect-src 'self' ${backend}; frame-src 'none'; base-uri 'none'; form-action 'self'`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content={policy} />
    <meta name="writer-api" content={backend} />
    <title>Admin · 0xnefertt</title>
  </head>
  <body>
    <Fragment set:html={editor} />
    <noscript>글쓰기를 사용하려면 JavaScript를 활성화해 주세요.</noscript>
    <script>
      import '../../../writer/src/client';
    </script>
  </body>
</html>
