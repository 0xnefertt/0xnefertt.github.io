{
  "scripts": {
    "setup": "npm install && npm --prefix astro install && npm --prefix writer install",
    "setup:ci": "npm ci && npm --prefix astro ci && npm --prefix writer ci",
    "post:new": "node scripts/new-post.mjs",
    "post:publish": "node scripts/post-publish.mjs",
    "post:image": "node scripts/post-image.mjs",
    "writer:setup": "npm --prefix writer ci",
    "writer:dev": "npm --prefix writer run dev",
    "writer:build": "npm --prefix writer run build",
    "writer:check": "npm --prefix writer run check",
    "writer:test": "npm --prefix writer run test",
    "writer:deploy": "npm --prefix writer run deploy",
    "astro:build": "npm --prefix astro run build",
    "astro:dev": "npm --prefix astro run dev",
    "verify:content": "node scripts/check-posts.mjs",
    "report:content": "node scripts/report-content.mjs",
    "verify:site-output": "node scripts/verify-site-output.mjs",
    "verify:build": "npm run astro:build && npm run verify:site-output && node scripts/verify-locales.mjs && node writer/scripts/verify-sitemap.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "npm run astro:dev",
    "build": "npm run astro:build",
    "astro:check": "npm --prefix astro run check",
    "audit": "npm audit && npm --prefix astro audit && npm --prefix writer audit",
    "verify": "npm run format:check && npm run audit && npm run verify:content && npm run astro:check && npm run writer:check && npm run writer:test && npm run verify:backup && npm run writer:build && npm run verify:build",
    "test:browser": "playwright test",
    "writer:backup": "python3 scripts/writer-backup.py export --remote",
    "writer:backup:verify": "python3 scripts/writer-backup.py verify",
    "verify:backup": "python3 scripts/writer-backup.py self-test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1"
  },
  "name": "0xnefertt.github.io",
  "version": "1.0.0",
  "private": true
}
