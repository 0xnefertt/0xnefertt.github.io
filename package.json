{
  "scripts": {
    "setup": "npm install && npm --prefix astro install",
    "setup:ci": "npm ci && npm --prefix astro ci",
    "post:new": "node scripts/new-post.mjs",
    "cv:pdf": "node scripts/set-cv-pdf.mjs",
    "astro:build": "npm --prefix astro run build",
    "astro:dev": "npm --prefix astro run dev",
    "verify:content": "node scripts/check-posts.mjs",
    "verify:site-output": "node scripts/verify-site-output.mjs",
    "verify:build": "npm run astro:build && npm run verify:site-output",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "npm run astro:dev",
    "build": "npm run astro:build"
  },
  "devDependencies": {
    "prettier": "3.1.1"
  },
  "name": "0xnefertt.github.io",
  "version": "1.0.0",
  "private": true
}
